# Copiar este archivo a ".env" y completar con valores reales.
# Usado por docker-compose.yml para levantar el proyecto.

# ---- SQL Server ----
MSSQL_SA_PASSWORD=CambiaEstaPassword123!

# ---- JWT ----
JWT_KEY=una_clave_secreta_larga_y_segura
JWT_ISSUER=mifitneslifeAppBackend
JWT_AUDIENCE=mifitneslifeAppFrontend
JWT_EXPIRY_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SMTP (envio de emails) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=MyfitnesLife
SMTP_SENDER_EMAIL=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# ---- Minio (servidor externo existente, no se containeriza) ----
MINIO_ENDPOINT=minio.myevents.digital
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=fitneslife-images
MINIO_IMAGE_EXERCISE_BUCKET=fitneslife-images-exersice
MINIO_VIDEO_EXERCISE_BUCKET=fitneslife-video-exersice
MINIO_USE_SSL=true

# ---- General ----
# URL(es) publica(s) del frontend, usada por el backend para CORS. Varias, separadas por coma.
FRONTEND_URL=http://localhost:5180,https://fitnes.thesender.net

# ---- Seed inicial ----
SEED_DEMO_PASSWORD=
SEED_SUPERADMIN_PASSWORD=

# ---- Frontend (Vite, se hornean en el build) ----
# Debe apuntar a la URL publica del backend, ej. http://localhost:8080/api
VITE_API_URL=https://fitnes.thesender.net/api
VITE_GOOGLE_CLIENT_ID=
